{
  "name": "@addstack/daw-ui",
  "version": "0.0.0-semantically-released",
  "description": "Headless React components for audio apps, in the spirit of Base UI: knobs, faders, number boxes, level meters and toggle groups you paint by dragging, like in Ableton Live and FL Studio.",
  "keywords": [
    "react",
    "daw",
    "audio",
    "music",
    "web-audio",
    "knob",
    "fader",
    "slider",
    "meter",
    "step-sequencer",
    "headless",
    "base-ui",
    "shadcn"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addstack/daw-ui.git"
  },
  "homepage": "https://github.com/addstack/daw-ui#readme",
  "bugs": {
    "url": "https://github.com/addstack/daw-ui/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json && tsc -p playground/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:perf": "playwright test -c playwright.perf.config.ts",
    "bench": "vitest bench --run",
    "check:size": "node scripts/size.mjs",
    "playground": "vite playground",
    "build:playground": "vite build playground",
    "check:package": "npx --yes publint && npx --yes @arethetypeswrong/cli --pack . --profile esm-only",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
